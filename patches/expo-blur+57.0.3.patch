@@ -0,0 +1,56 @@
+package expo.modules.blur
+
+import android.graphics.RenderEffect
+import android.graphics.RuntimeShader
+import android.view.View
+import androidx.annotation.RequiresApi
+
+/** MingYue: a static optical lens on the blurred background, never on text. */
+@RequiresApi(33)
+internal class LiquidLens {
+  private val shader = RuntimeShader("""
+    uniform shader content;
+    uniform float2 resolution;
+    uniform float radius;
+    uniform float density;
+    uniform float strength;
+    uniform float light;
+
+    float sdRoundBox(float2 p, float2 halfSize, float r) {
+      float2 q = abs(p) - halfSize + float2(r);
+      return length(max(q, float2(0.0))) + min(max(q.x, q.y), 0.0) - r;
+    }
+
+    half4 main(float2 coord) {
+      float2 halfSize = resolution * 0.5;
+      float r = min(radius, min(halfSize.x, halfSize.y));
+      float2 p = coord - halfSize;
+      float d = sdRoundBox(p, halfSize, r);
+      float stepSize = max(density, 1.0);
+      float2 gradient = float2(
+        sdRoundBox(p + float2(stepSize, 0.0), halfSize, r) - sdRoundBox(p - float2(stepSize, 0.0), halfSize, r),
+        sdRoundBox(p + float2(0.0, stepSize), halfSize, r) - sdRoundBox(p - float2(0.0, stepSize), halfSize, r)
+      );
+      float2 normal = gradient / max(length(gradient), 0.001);
+      float edgeWidth = max(min(min(halfSize.x, halfSize.y) * 0.6, 18.0 * density), 1.0);
+      float edge = pow(clamp(1.0 + d / edgeWidth, 0.0, 1.0), 2.0);
+      float2 samplePoint = clamp(coord - normal * edge * 9.0 * density * strength, float2(0.5), resolution - float2(0.5));
+      half4 color = content.eval(samplePoint);
+      float rim = exp(-abs(d + density) / max(density * 1.2, 0.5));
+      float shine = rim * max(dot(normal, float2(-0.6, -0.8)), 0.0) * 0.32 * strength;
+      float shade = rim * max(dot(normal, float2(0.6, 0.8)), 0.0) * 0.05 * strength * light;
+      half3 rgb = clamp(color.rgb + half3(shine - shade) * color.a, half3(0.0), half3(color.a));
+      return half4(rgb, color.a);
+    }
+  """.trimIndent())
+
+  fun apply(view: View, strength: Float, cornerRadius: Float, light: Boolean) {
+    val density = view.resources.displayMetrics.density
+    shader.setFloatUniform("resolution", view.width.toFloat(), view.height.toFloat())
+    shader.setFloatUniform("radius", cornerRadius * density)
+    shader.setFloatUniform("density", density)
+    shader.setFloatUniform("strength", strength.coerceIn(0f, 1f))
+    shader.setFloatUniform("light", if (light) 1f else 0f)
+    view.setRenderEffect(RenderEffect.createRuntimeShaderEffect(shader, "content"))
+  }
+}
